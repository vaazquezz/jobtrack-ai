# Copy this file to backend/.env and adjust values. Never commit real secrets.

# SQLite database location (relative to the backend/ directory)
DATABASE_URL=sqlite:///./jobtrack.db

# Comma-separated list of origins allowed to call the API (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# Optional AI analysis of job offers. Leave the key empty to use only the local
# keyword analysis. Never commit a real key: put it in backend/.env (git-ignored).
ANTHROPIC_API_KEY=
# Claude model used for AI analysis.
ANTHROPIC_MODEL=claude-opus-5-5
# Seconds to wait for the AI provider before giving up, and retries on transient errors.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
